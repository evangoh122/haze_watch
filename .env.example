# Copy to .env and fill in. Never commit real values.

# --- Database ---
POSTGRES_USER=haze
POSTGRES_PASSWORD=change-me
POSTGRES_DB=haze_watch
DATABASE_URL=postgresql+psycopg://haze:change-me@localhost:5432/haze_watch

# --- Backend ---
APP_ENV=development
API_PREFIX=/api/v1
# Single origin, comma-separated origins, or a JSON array - all parse correctly.
CORS_ORIGINS=http://localhost:5173
# Optional override for the data API's pipeline-output directory (default: <repo>/data; Docker: /data).
# DATA_DIR=data

# --- External data sources ---
# NASA FIRMS API key (https://firms.modaps.eosdis.nasa.gov/api/).
# Backend reads FIRMS_API_KEY; the pipelines package accepts this same name
# as an alias of HAZE_FIRMS_API_KEY.
FIRMS_API_KEY=
# Open-Meteo forecast API (backend).
OPEN_METEO_URL=https://api.open-meteo.com/v1
# Open-Meteo historical/ERA5 archive API (pipelines). Optional: has a default.
HAZE_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# Optional override for the pipelines data directory (default: ./data).
# HAZE_DATA_DIR=data

# --- LLM chat layer (backend/app/llm) ---
# Any OpenAI-compatible endpoint works; empty base_url + api_key => deterministic
# data-grounded fallback (no LLM calls, nothing invented).
# DeepSeek example (recommended):
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Alternatives: LLM_MODEL=deepseek-reasoner | OpenAI: https://api.openai.com/v1
# | Databricks Foundation Model API / Unity Gateway OpenAI-compatible base URL.

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
